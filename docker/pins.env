# C++ toolchain: gcc per cuDF version; nvcc for every version, installed outside /opt/cudf
GCC_25_02=12
GCC_25_10=14
GCC_26_02=14
NVCC_VERSION=12.9.86
# The driver each run image needs: the toolkit driver of its spec's cudart (release notes,
# Table 3). 12.2.140 is CUDA 12.2 Update 2, 12.9.79 is 12.9 Update 1. A version with none, 25.10,
# has a build image only, for CI
DRIVER_MINIMUM_25_02=535.104.05
DRIVER_MINIMUM_26_02=575.57.08
CMAKE_VERSION=4.2.3
CMAKE_SHA256=5bb505d5e0cca0480a330f7f27ccf52c2b8b5214c5bba97df08899f5ef650c23
NINJA_VERSION=1.12.1
# ninja publishes no checksum: the sha256 of the release zip, measured
NINJA_SHA256=6f98805688d19672bd699fbbfa2c2cf0fc054ac3df1f0e6a47664d963d530255
# Rust stable, edition 2024 needs >= 1.85
RUST_VERSION=1.99.0
# DuckDB CLI and Python: the committed costs depend on these bytes
DUCKDB_VERSION=1.5.4
DUCKDB_SHA256=1f2fa724fb054b3dbe1a9cbd13de5b76997d850e7087ec762ba88db04e0180cf
PYTHON_VERSION=3.13.0
PYTHON_STANDALONE_TAG=20241008
PYTHON_SHA256=455200e1a202e9d9ef4b630c04af701c0a91dcaa6462022efc76893fc762ec95
PANDAS_VERSION=3.0.6
PYARROW_VERSION=25.0.1
NUMPY_VERSION=2.5.4
MATPLOTLIB_VERSION=3.11.2
PY_DUCKDB_VERSION=1.5.4
# Tools with no data in them; gh and micromamba with their published sha256
CLAUDE_CODE_VERSION=2.1.304
# The official marketplace pins each plugin to a commit; the image build refuses any other
SUPERPOWERS_VERSION=7.0.0
SUPERPOWERS_SHA=bb92a77741419a4ab5f06e711a283343f1ada0c3
GH_VERSION=2.102.1
GH_SHA256=77b9e297e94c50336823d0f84de7ef1be60cba704601fa0d98f129f47a94987b
AWS_CLI_VERSION=2.38.3
# AWS publishes a PGP signature, not a checksum: the sha256 of the zip, measured
AWS_CLI_SHA256=ae55fa4aa6653fc296f38eac500873e3b0e798d02a35f305c692d02fc835c548
# A provider CLI, with no config or profile: nebius publishes no checksum, the binary's, measured
NEBIUS_VERSION=0.12.293
NEBIUS_SHA256=a4176af5d90c7efd8dbcd938d087dd43b749e6cb131746332870c79aa421d026
MICROMAMBA_VERSION=2.9.0-0
