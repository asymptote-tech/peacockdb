# Rust
target/
# shad-gpu's builds keep a cargo target per cuDF root (scripts/lib/shadgpu-env.sh:
# target-cudf-<cudf_root_basename>, e.g. target-cudf-rapids-cuda-12.2). The glob also covers
# the dirs the retired host builds left in older worktrees.
target-cudf*/
# A run in the build image keeps its cargo target, one per cuDF version, and its HOME in the
# tree: docker run ... -e CARGO_TARGET_DIR=$PWD/target-img-<v> -e HOME=$PWD/.home-img.
/target-img-*/
/.home-img/

# CMake / C++ build artifacts
cpp/build/
cpp/install/

# Editor / IDE
compile_commands.json
.cache
.vscode/
.idea/
*.swp
*.swo
*~

# Generated FlatBuffers code (built from flatbuffers/gpu_plan.fbs)
cpp/include/generated/
peacockdb-core/src/generated/

# OS
.DS_Store
cufile.log

# DuckDB cost-oracle cache (generated, not committed)
testdata/*/.duckdb_cache/

# Python bytecode (duckdb_cost.py tests)
__pycache__/
*.pyc

# Local-only embedding source cache (fetch_embeddings.sh); never committed — data ships as parquet
testdata/embeddings-cache/

# Agent working directory: this repo is developed by the ensemble in llm-wiki/prompts.md.
# The agent definitions and the /ensemble command are project state and must be committed —
# git worktrees do not carry ignored files, so a chain worktree without them cannot spawn a
# developer. The directory line is a glob because git will not re-include a file inside an
# excluded directory. Everything else here, .claude/ensemble/ run state included, is
# per-checkout tooling config.
.claude/*
!.claude/agents/
!.claude/commands/

# The 26.02 build tree; cpp/build (25.02) is covered above and this one was not,
# so a `git add cpp` swept 1069 build artifacts into a commit once.
cpp/build26/

# Scratch at the repo root — papers, one-off scripts, rendered reports. Nothing tracked
# sits loose here but README.md and the build files, and `git add -A .` once swept
# thirteen of these into a commit, 25 MB of PDFs among them.
/*.pdf
/*.tsv
/*.txt
/*.html
/*.sh

# query-fuser: the fused batches' record, which the metrics pass reads.
testdata/calibration/fused/
